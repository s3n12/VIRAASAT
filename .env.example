# ==============================================================================
# VIRAASAT — Secure Environment Configuration Template
# Never commit real credentials or secrets to version control.
# Configure these values in AI Studio Settings -> Secrets or your hosting provider.
# ==============================================================================

# Public Site & App URLs
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ==============================================================================
# 1. SUPABASE AUTH & POSTGRESQL (Your Existing Supabase Project)
# Obtain from: Supabase Dashboard -> Project Settings -> API
#   - Project URL        -> VITE_SUPABASE_URL & SUPABASE_URL
#   - Anon / Publishable -> VITE_SUPABASE_ANON_KEY & SUPABASE_ANON_KEY
#   - Service Role Key   -> SUPABASE_SERVICE_ROLE_KEY (server-only, NEVER VITE_)
# Copy this file to `.env` (gitignored) or add keys in AI Studio Settings -> Secrets.
# ==============================================================================
# Vite browser-accessible public variables (VITE_ prefix required by Vite)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
VITE_SUPABASE_RAW_TABLE="VIRAASAT-RAw"

# Server-side variables (Express API routes in server.ts)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RAW_TABLE="VIRAASAT-RAw"

# Optional Next.js-compatible aliases
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==============================================================================
# 2. SUPABASE CUSTOM SEND SMS HOOK + MSG91 (Indian +91 SMS OTP)
# Obtain Hook Secret from: Supabase Dashboard -> Authentication -> Hooks -> Send SMS Hook
# Obtain MSG91 credentials from: MSG91 Dashboard -> Authkey & SMS -> Templates (DLT Approved)
# ==============================================================================
SUPABASE_SMS_HOOK_SECRET=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID="VRSATP"
MSG91_OTP_VAR_NAME="otp"

# ==============================================================================
# 3. RESEND SMTP (Configured inside Supabase Dashboard -> Auth -> SMTP Settings)
# Obtain from: Resend Dashboard -> API Keys (after verifying your sending domain)
# Host: smtp.resend.com | Port: 465 | User: resend | Pass: <RESEND_API_KEY>
# ==============================================================================
RESEND_API_KEY=
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_FROM="auth@your-verified-domain.com"

# ==============================================================================
# 4. BOT PROTECTION (Cloudflare Turnstile CAPTCHA)
# Obtain from: Cloudflare Dashboard -> Turnstile -> Add Widget
# ==============================================================================
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ==============================================================================
# 5. RAZORPAY PAYMENTS (Server-side secret + Webhook signature secret)
# ==============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
