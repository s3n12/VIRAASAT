# ==============================================================================
# VIRAASAT — Environment Configuration Template
# Never commit real secrets to version control.
# ==============================================================================

# Public Site & App URLs
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-Side Cryptographic Session & OTP Secrets (32+ random hex bytes each)
SESSION_SECRET=
OTP_HMAC_SECRET=
ADMIN_BOOTSTRAP_PASSCODE=

# Supabase PostgreSQL Configuration (Reference SQL target)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional Email OTP & Notifications (Resend / SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT="587"
SMTP_USER=
SMTP_PASS=
SMTP_FROM="concierge@viraasat.in"

# SMS OTP & Security Notifications (MSG91 or Twilio)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Razorpay Payment Gateway (Server-side secret + Webhook signature secret)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
